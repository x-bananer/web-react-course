root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,mjs,cjs,ts,tsx}]
indent_style = tab
indent_size = 4
tab_width = 4

[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,mjs,cjs,ts,tsx,css,html,json}]
max_line_length = 80
